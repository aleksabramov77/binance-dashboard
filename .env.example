# Read-only API-ключ Binance (Account → API Management → Create API → System generated).
# Права: только "Enable Reading". Торговлю и вывод НЕ включать.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Ключ Binance Demo Trading (demo.binance.com → API Management) — виртуальные деньги.
# Нужен для «Сделки в 1 клик» на странице «Сигналы» и для demo-зеркала экспериментов (spec 008).
# Права: чтение + торговля Spot/Futures. Для зеркала в облаке тот же ключ задаётся на Vercel (Production).
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# Серверный лимит объёма одной демо-сделки, USD (по умолчанию 1000).
# DEMO_MAX_NOTIONAL_USD=1000

# OpenRouter (openrouter.ai → Keys) — «Разбор от ИИ» на странице «Сигналы».
OPENROUTER_API_KEY=
# Модель разбора (по умолчанию anthropic/claude-haiku-5.5).
# ANALYSIS_MODEL=anthropic/claude-haiku-5.5

# Вход через GitHub (Auth.js). Локально можно не задавать — защита выключится.
# В production (NODE_ENV=production) без этих переменных приложение закрыто (503).
# Секрет сессий: openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Кому можно войти: логины GitHub через запятую.
AUTH_ALLOWED_GITHUB_LOGINS=aleksabramov77

# Пропуск для расписаний: pg_cron в Supabase вызывает на Vercel POST /api/cron/* (снимок Earn, монитор
# журнала) с Authorization: Bearer <CRON_SECRET>. Задаётся в переменных Vercel и копией в Vault Supabase
# (pnpm earn:supabase / monitor:supabase cron-install); на Mac не нужен. Сгенерировать: openssl rand -hex 32
# CRON_SECRET=

# Роль этого процесса как тик-раннера лаборатории: oracle (Mac или VM, по умолчанию) | supabase.
# Тик работает, только если роль совпадает с engine_state.runner в БД (сейчас supabase) — spec 007b.
# На Mac оставьте oracle: локальный сервер тогда не торгует параллельно с облаком.
ENGINE_RUNNER=oracle

# Где работает процесс (spec 0017): vm — своя VM AWS Lightsail (источник журнала vm, хостинг «облако»).
# На Vercel и на Mac не задаётся. На VM задаётся в /etc/binance/app.env.
# APP_HOST=vm

# --- Supabase: база данных и тик движка (основной хостинг, spec 007b) ---
# Проект binance-lab, регион Northeast Asia (Tokyo). Реальные значения — только в .env.local.
#
# Имя проекта (Project name в панели Supabase), справочно.
SUPABASE_NAME=
# Пароль базы (Database Password, задаётся при создании проекта) — он же подставляется
# в DATABASE_URL вместо [YOUR-PASSWORD]. Приложение ходит в БД напрямую через DATABASE_URL.
SUPABASE_DB_PASSWORD=
#
# Строка подключения к Postgres: кнопка Connect (вверху панели) → Connection String →
# Method: Transaction pooler (порт 6543) → скопировать URI и вставить пароль базы вместо
# [YOUR-PASSWORD]. Пусто — локальный PGlite в PGLITE_DIR (внешние сервисы не нужны).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# PGLITE_DIR=data/pglite
#
# Для деплоя Edge Functions и скриптов pnpm *:supabase: Project ID (Project Settings → General) и личный токен
# Supabase CLI (Account → Access Tokens → Generate new token; права: Project — Read,
# Application services → Edge Functions и Secrets — Read & Write, чтение API-ключей проекта
# (`api_gateway_keys_read` — чтобы взять publishable/anon ключ для вызова функций), остальное — No access).
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# Publishable key проекта (Project Settings → API Keys → sb_publishable_…), не секретный: им вызываем
# Edge Functions (binance-ping) из скриптов.
# SUPABASE_PUBLISHABLE_KEY=
#
# Ключ вызова Edge Function engine-tick (spec 007b): секрет функции и Vault `engine_tick_secret`.
# Создаёт `pnpm engine:supabase secret` (или cron-install) и сам дописывает сюда; в git не коммитить.
# ENGINE_TICK_SECRET=

# --- Vercel: токен для скриптов (статус деплоев, пересборка) ---
# vercel.com → Account Settings → Tokens → Create Token. Переменные проекта на Vercel задаются отдельно.
# VERCEL_TOKEN=

# --- Telegram: уведомления монитора журнала ---
# Уведомления монитора журнала в Telegram (бот @binance_dashboard_gold_bot). Токен — у @BotFather;
# chat id — `pnpm monitor:supabase chat-id` после Start у бота.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Модель разбора сбоев (OpenRouter), по умолчанию anthropic/claude-haiku-5.5.
# LOG_ANALYSIS_MODEL=anthropic/claude-haiku-5.5
# Секрет webhook команд бота (/db, /help): Telegram шлёт его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Задаётся в переменных Vercel и здесь — для `pnpm telegram:setup`. Сгенерировать: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=
# Лимит размера базы для /db и уведомлений о свободном месте, МБ (по умолчанию 500 — Supabase Free).
# DB_SIZE_LIMIT_MB=500

# --- GitHub: задачи по тревогам монитора (spec 0037) ---
# Новая тревога монитора заводит issue в приватном репозитории с меткой alert — она запускает routine Claude
# (.claude/routines/alert-triage.md), повтор — комментарий в открытый issue. Без токена — только Telegram.
# Fine-grained PAT (GitHub → Settings → Developer settings → Fine-grained tokens): доступ только к
# binance-dashboard-private, права Issues — Read and write. Задаётся в переменных Vercel (Production); на Mac не нужен.
# GITHUB_ALERTS_TOKEN=
# Репозиторий задач owner/name (по умолчанию aleksabramov77/binance-dashboard-private).
# GITHUB_ALERTS_REPO=aleksabramov77/binance-dashboard-private
# Сколько issue за 24 ч запускают Claude; сверх — метка alert-queued, без автозапуска (по умолчанию 3).
# ALERT_AUTOFIX_PER_DAY=3
