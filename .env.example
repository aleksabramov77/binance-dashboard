# Read-only API-ключ Binance (Account → API Management → Create API → System generated).
# Права: только "Enable Reading". Торговлю и вывод НЕ включать.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Мастер-ключ секретов в базе (spec 0065): файл с 32 случайными байтами в base64. Им шифруется read-only ключ
# основного аккаунта, введённый в «Настройках» → «Основной аккаунт». На VM — /etc/binance/master.key (создаёт
# scripts/server/add-project.sh, root:binance 640), путь — в /etc/binance/app.env. Без него ввод на сайте недоступен.
# SECRETS_KEY_FILE=/etc/binance/master.key

# Заглушка Binance для проверки ввода ключа на локальном сервере (spec 0065): read-only — ключ годится, trading —
# отказ по правам, rejected — Binance не принял ключ. Работает только на Mac и не в production; на VM не задаётся.
# ACCOUNT_KEY_FIXTURE=read-only

# Ключ Binance Demo Trading (demo.binance.com → API Management) — виртуальные деньги.
# Нужен для «Сделки в 1 клик» на странице «Сигналы» и для demo-зеркала экспериментов (spec 008).
# Права: чтение + торговля Spot/Futures. Для зеркала в облаке тот же ключ задаётся на Vercel (Production).
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# Серверный лимит объёма одной демо-сделки, USD (по умолчанию 1000).
# DEMO_MAX_NOTIONAL_USD=1000

# OpenRouter (openrouter.ai → Keys) — «Разбор от ИИ» на странице «Сигналы».
OPENROUTER_API_KEY=
# Модель разбора (по умолчанию anthropic/claude-haiku-5.5).
# ANALYSIS_MODEL=anthropic/claude-haiku-5.5

# Вход через GitHub (Auth.js). Локально можно не задавать — защита выключится.
# В production (NODE_ENV=production) без этих переменных приложение закрыто (503).
# Секрет сессий: openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Кому можно войти: логины GitHub через запятую.
AUTH_ALLOWED_GITHUB_LOGINS=aleksabramov77

# Пропуск для расписаний: pg_cron в Supabase вызывает на Vercel POST /api/cron/* (снимок Earn, монитор
# журнала) с Authorization: Bearer <CRON_SECRET>. Задаётся в переменных Vercel и копией в Vault Supabase
# (pnpm earn:supabase / monitor:supabase cron-install); на Mac не нужен. Сгенерировать: openssl rand -hex 32
# CRON_SECRET=

# Роль этого процесса как тик-раннера лаборатории: oracle (Mac или VM, по умолчанию) | supabase.
# Тик работает, только если роль совпадает с engine_state.runner в БД (сейчас supabase) — spec 007b.
# На Mac оставьте oracle: локальный сервер тогда не торгует параллельно с облаком.
ENGINE_RUNNER=oracle

# Где работает процесс (spec 0017): vm — своя VM AWS Lightsail (источник журнала vm, хостинг «облако»).
# На Vercel и на Mac не задаётся. На VM задаётся в /etc/binance/app.env.
# APP_HOST=vm

# Каталог файлового журнала (JSON-строки app-YYYY-MM-DD.jsonl, с debug). По умолчанию data/logs в каталоге
# процесса; на VM код только для чтения (ProtectSystem=strict) — задаётся в /etc/binance/app.env (spec 0055).
# LOG_DIR=/var/lib/binance/logs

# Файл базы приложения — SQLite (spec 0059). По умолчанию data/app.db в каталоге проекта: локальная база, у
# каждого worktree своя (pnpm wt serve). На VM — /var/lib/binance/app.db, задаётся в /etc/binance/app.env.
# DATABASE_PATH=data/app.db

# --- Supabase: прежняя база Postgres (до spec 0059) — перенос данных и скрипты pnpm *:supabase ---
# Проект binance-lab, регион Northeast Asia (Tokyo). Реальные значения — только в .env.local.
#
# Имя проекта (Project name в панели Supabase), справочно.
SUPABASE_NAME=
# Пароль базы (Database Password, задаётся при создании проекта) — он же подставляется
# в DATABASE_URL вместо [YOUR-PASSWORD]. Приложение DATABASE_URL не читает (spec 0059) — он нужен только
# `pnpm db:import-pg` (перенос в SQLite) и скриптам pnpm *:supabase до отключения Supabase.
SUPABASE_DB_PASSWORD=
#
# Строка подключения к Postgres: кнопка Connect (вверху панели) → Connection String →
# Method: Transaction pooler (порт 6543) → скопировать URI и вставить пароль базы вместо
# [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
#
# Для деплоя Edge Functions и скриптов pnpm *:supabase: Project ID (Project Settings → General) и личный токен
# Supabase CLI (Account → Access Tokens → Generate new token; права: Project — Read,
# Application services → Edge Functions и Secrets — Read & Write, чтение API-ключей проекта
# (`api_gateway_keys_read` — чтобы взять publishable/anon ключ для вызова функций), остальное — No access).
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# Publishable key проекта (Project Settings → API Keys → sb_publishable_…), не секретный: им вызываем
# Edge Functions (binance-ping) из скриптов.
# SUPABASE_PUBLISHABLE_KEY=
#
# Ключ вызова Edge Function engine-tick (spec 007b): секрет функции и Vault `engine_tick_secret`.
# Создаёт `pnpm engine:supabase secret` (или cron-install) и сам дописывает сюда; в git не коммитить.
# ENGINE_TICK_SECRET=

# --- Vercel: токен для скриптов (статус деплоев, пересборка) ---
# vercel.com → Account Settings → Tokens → Create Token. Переменные проекта на Vercel задаются отдельно.
# VERCEL_TOKEN=

# --- Telegram: уведомления и команды бота ---
# Уведомления (log.notify, spec 0067) и ответы на команды — бот @binance_dashboard_gold_bot. Токен — у @BotFather.
# TELEGRAM_CHAT_ID — куда уведомления: закрытая группа с темами (id группы, отрицательный: напишите в группе /help —
# id попадёт в /logs записью telegram.foreign) или, как раньше, личный чат владельца (`pnpm monitor:supabase chat-id`
# после Start у бота). Шлёт только прод-сервер VM (APP_HOST=vm); на VM — /etc/binance/app.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Владелец — ваш id пользователя Telegram (он же chat id личного чата с ботом, положительный): бот отвечает на ваши
# команды в личке и в группе, чужим — нет; отрицательный (id группы) игнорируется. По умолчанию — TELEGRAM_CHAT_ID,
# если это личный чат; TELEGRAM_CHAT_ID — группа — задать обязательно, иначе бот перестанет отвечать в личке.
# На VM — /etc/binance/app.env.
# TELEGRAM_OWNER_ID=
# Темы группы (message_thread_id) по категориям уведомлений: 💰 Сделки, 🧪 Лаборатория, 🖥 Сервер (и сторож), 🚨 Ошибки.
# Создаёт темы и печатает эти строки `pnpm telegram:setup --topics`; не задана — сообщения категории в чат без темы.
# На VM — /etc/binance/app.env (сторож берёт TELEGRAM_TOPIC_SERVER оттуда же).
# TELEGRAM_TOPIC_TRADES=
# TELEGRAM_TOPIC_LAB=
# TELEGRAM_TOPIC_SERVER=
# TELEGRAM_TOPIC_ERRORS=
# Адрес прода для ссылок в сообщениях бота (/settings#live, /logs) и webhook в `pnpm telegram:setup`.
# Задаётся в env сервиса на VM (/etc/binance/app.env): https://binance.<ip>.sslip.io. Не задан — сообщения без ссылки.
# SITE_URL=
# Модель разбора сбоев (OpenRouter), по умолчанию anthropic/claude-haiku-5.5.
# LOG_ANALYSIS_MODEL=anthropic/claude-haiku-5.5
# Секрет webhook команд бота (/db, /help): Telegram шлёт его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Задаётся в переменных Vercel и здесь — для `pnpm telegram:setup`. Сгенерировать: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# --- GitHub: задачи по тревогам монитора (spec 0037) ---
# Новая тревога монитора заводит issue в приватном репозитории с меткой alert — она запускает routine Claude
# (.claude/routines/alert-triage.md), повтор — комментарий в открытый issue. Без токена — только Telegram.
# Fine-grained PAT (GitHub → Settings → Developer settings → Fine-grained tokens): доступ только к
# binance-dashboard-private, права Issues — Read and write. Задаётся в переменных Vercel (Production); на Mac не нужен.
# GITHUB_ALERTS_TOKEN=
# Репозиторий задач owner/name (по умолчанию aleksabramov77/binance-dashboard-private).
# GITHUB_ALERTS_REPO=aleksabramov77/binance-dashboard-private
# Сколько issue за 24 ч запускают Claude; сверх — метка alert-queued, без автозапуска (по умолчанию 3).
# ALERT_AUTOFIX_PER_DAY=3

# --- Реальный счёт (только VM, spec 0047) ---
# Торговый ключ СУБСЧЁТА Binance (Sub Accounts → API Management → [субсчёт] → Create API): только Enable Reading,
# Enable Spot & Margin Trading, Enable Futures и Restrict access to trusted IPs only (IP VM). Вывод, внутренние и
# универсальные переводы, Margin Loan — выключены (воркер проверяет и блокирует). Задаётся только в env воркера на VM
# (/etc/binance-live/app.env) — не на Vercel, не в Supabase и не на Mac: ключ работает только с IP VM.
# BINANCE_TRADE_API_KEY=
# BINANCE_TRADE_API_SECRET=
# Секрет пульса воркера → POST /api/live/heartbeat (Bearer). Задаётся у воркера на VM и в переменных Vercel
# (Production), одинаковый. Локально без него пульс принимается (в production без него — 503). openssl rand -hex 32
# LIVE_WORKER_SECRET=
# Адрес приложения, куда воркер шлёт пульс (env воркера): до переезда — Vercel, после — VM; локально —
# адрес pnpm wt serve (http://localhost:<порт>).
# LIVE_APP_URL=https://binance-dashboard-gold.vercel.app
# Через сколько секунд без пульса карточка и монитор считают, что воркер молчит (по умолчанию 300 — 5 мин).
# Задаётся у приложения (Vercel); для локальной проверки — меньше, например 60.
# LIVE_SILENT_AFTER_SEC=300

# --- Своя VM apps-tokyo: доступ по SSH для скриптов (spec 0059) ---
# pnpm db:pull и pnpm lab:report --prod скачивают снимок прод-базы (sqlite3 .backup на VM → data/prod.db).
# Адрес — static IP инстанса (Lightsail → Networking; тот же, что в секрете Actions APPS_TOKYO_HOST), в репозиторий не пишется.
# APPS_TOKYO_HOST=
# Пользователь SSH (по умолчанию claude — администратор VM с sudo) и ключ (по умолчанию ~/.ssh/lightsail_apps_tokyo).
# APPS_TOKYO_SSH_USER=claude
# APPS_TOKYO_SSH_KEY_FILE=~/.ssh/lightsail_apps_tokyo
