# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# локальные снимки Binance Earn
/data
!.env.example

# worktrees Claude Code
/.claude/worktrees

# Supabase CLI (локальное состояние, project ref)
supabase/.temp/
supabase/.branches/

# Deno lock от supabase CLI при деплое функций (версии — в deno.json)
supabase/functions/**/deno.lock
