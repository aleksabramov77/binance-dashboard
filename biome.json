{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/pages/*/**",
                  "@/widgets/*/**",
                  "@/features/*/**",
                  "@/entities/*/**"
                ],
                "message": "FSD: импортируйте слайс только через его public API (index.ts), без deep imports."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/trading-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "@tanstack/**",
                      "node:*"
                    ],
                    "message": "trading-core автономен: без UI, Next.js, кода приложения и Node API (packages/trading-core/README.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/paper-engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "node:*"
                    ],
                    "message": "paper-engine среда-независим (Node и Deno): только trading-core, zod и свои модули (src/features/paper-engine/README.md)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
