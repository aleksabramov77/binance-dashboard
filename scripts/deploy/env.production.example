# Окружение приложения на VM: /opt/binance-dashboard/.env.production.local (chmod 600, не в git).
# Next.js читает его сам при `next start`. Заполняется по docs/ai/deploy.md.

# --- Ключи Binance на сервер НЕ кладём (решение владельца 2026-10-10) ---
# BINANCE_API_KEY / BINANCE_API_SECRET (реальный аккаунт) — запрещены всегда: deploy.sh остановится.
# Движок экспериментов работает на публичных данных Binance без ключа.
# Demo-ключи — только по отдельному решению владельца, вместе с ALLOW_DEMO_KEYS=yes:
# ALLOW_DEMO_KEYS=yes
# BINANCE_DEMO_API_KEY=
# BINANCE_DEMO_API_SECRET=

# База данных: Supabase → Connect → Connection string → Session pooler (IPv4), порт 5432.
DATABASE_URL=

# Вход через GitHub (Auth.js). Финальный список — в PR задачи 4 (docs/ai/architecture.md).
# AUTH_SECRET — случайная строка: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://<ip>.sslip.io
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ALLOWED_GITHUB_LOGINS=aleksabramov77

# Секрет для POST /api/cron/tick (внешний крон, если понадобится): openssl rand -hex 32
CRON_SECRET=

# OpenRouter — «Разбор от ИИ». Доступ к приложению закрыт входом через GitHub.
OPENROUTER_API_KEY=
# ANALYSIS_MODEL=anthropic/claude-haiku-5.5
