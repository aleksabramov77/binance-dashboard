{
  "name": "binance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/run-on-free-port.ts dev",
    "build": "next build",
    "start": "tsx scripts/run-on-free-port.ts start",
    "lint": "biome check",
    "lint:fsd": "steiger ./src",
    "format": "biome format --write",
    "snapshot": "tsx scripts/snapshot.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm lint:fsd && pnpm typecheck && pnpm test",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "schedule:install": "bash scripts/install-schedule.sh"
  },
  "dependencies": {
    "@binance-dashboard/trading-core": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "steiger": "0.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.5"
}
