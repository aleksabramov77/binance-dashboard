{
  "name": "binance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/run-on-free-port.ts dev",
    "build": "next build",
    "start": "tsx scripts/run-on-free-port.ts start",
    "lint": "biome check",
    "lint:fsd": "steiger ./src",
    "format": "biome format --write",
    "snapshot": "tsx scripts/snapshot.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "engine:supabase": "tsx scripts/engine-supabase.ts",
    "earn:supabase": "tsx scripts/earn-supabase.ts",
    "monitor:supabase": "tsx scripts/monitor-supabase.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "mirror:supabase": "tsx scripts/mirror-supabase.ts",
    "wt": "tsx scripts/worktree.ts",
    "lab:private": "tsx scripts/lab-private.ts",
    "lab:report": "tsx scripts/lab-report.ts",
    "lab:apply": "tsx scripts/lab-apply.ts",
    "glossary": "tsx scripts/glossary.ts",
    "check:edge": "pnpm dlx deno@2.9.6 check --config supabase/functions/engine-tick/deno.json supabase/functions/engine-tick/index.ts supabase/functions/binance-ping/index.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm lint:fsd && pnpm typecheck && pnpm test",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "schedule:install": "bash scripts/install-schedule.sh"
  },
  "dependencies": {
    "@binance-dashboard/trading-core": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nuqs": "^2.10.2",
    "postgres": "3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.1",
    "steiger": "0.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.5"
}
